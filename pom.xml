<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.che1s</groupId>
    <artifactId>craftenginerecipe</artifactId>
    <version>1.1.0</version>
    <packaging>jar</packaging>
    <name>CraftEngineRecipe</name>
    <description>基于 CraftEngine 物品的高级配方浏览器（常驻分类栏 + 搜索）</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- The default build targets Minecraft 26.2. Select exactly one mc-* profile for other versions. -->
        <mc.label>26.2</mc.label>
        <!-- The real minimum API, also used by Modrinth to infer Minecraft versions. -->
        <mc.api.version>26.2</mc.api.version>
        <paper.version>26.2.build.132-stable</paper.version>
        <craftengine.version>26.8.1</craftengine.version>
        <invui.version>2.3.2</invui.version>
        <pinyin4j.version>2.5.1</pinyin4j.version>
        <sqlite.version>3.49.1.0</sqlite.version>
        <vanilla.recipe.directory>minecraft-${mc.label}</vanilla.recipe.directory>

        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
        <maven.resources.plugin.version>3.3.1</maven.resources.plugin.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>momirealms</id>
            <url>https://repo.momirealms.net/releases/</url>
        </repository>
        <repository>
            <id>xenondevs</id>
            <url>https://repo.xenondevs.xyz/releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>net.momirealms</groupId>
            <artifactId>craft-engine-bukkit</artifactId>
            <version>${craftengine.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.momirealms</groupId>
            <artifactId>craft-engine-core</artifactId>
            <version>${craftengine.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>xyz.xenondevs.invui</groupId>
            <artifactId>invui</artifactId>
            <version>${invui.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.jetbrains</groupId>
                    <artifactId>annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-base</artifactId>
            <version>3.0.2</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.belerweb</groupId>
            <artifactId>pinyin4j</artifactId>
            <version>${pinyin4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>mc-26.1</id>
            <properties>
                <mc.label>26.1</mc.label>
                <mc.api.version>26.1.2</mc.api.version>
                <paper.version>26.1.2.build.74-stable</paper.version>
                <invui.version>2.1.1</invui.version>
            </properties>
        </profile>
        <profile>
            <id>mc-26.2</id>
            <properties>
                <mc.label>26.2</mc.label>
                <mc.api.version>26.2</mc.api.version>
                <paper.version>26.2.build.132-stable</paper.version>
                <invui.version>2.3.2</invui.version>
            </properties>
        </profile>
        <profile>
            <id>mc-26.3</id>
            <properties>
                <mc.label>26.3</mc.label>
                <mc.api.version>26.3</mc.api.version>
                <paper.version>26.3.build.181-stable</paper.version>
                <invui.version>2.5.1</invui.version>
            </properties>
        </profile>
    </profiles>

    <build>
        <finalName>CraftEngineRecipe-${project.version}-mc${mc.label}</finalName>
        <!-- Maintained regression tests; src/test remains ignored for local experiments. -->
        <testSourceDirectory>tests/java</testSourceDirectory>
        <testResources>
            <testResource>
                <directory>tests/resources</directory>
            </testResource>
        </testResources>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                    <exclude>recipes/minecraft-*/**</exclude>
                    <exclude>recipes/cultivation/minecraft-*/**</exclude>
                    <exclude>vanilla-lang/minecraft-*/**</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources/recipes/${vanilla.recipe.directory}</directory>
                <targetPath>recipes/${vanilla.recipe.directory}</targetPath>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources/recipes/cultivation/${vanilla.recipe.directory}</directory>
                <targetPath>recipes/cultivation/${vanilla.recipe.directory}</targetPath>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources/vanilla-lang/${vanilla.recipe.directory}</directory>
                <targetPath>vanilla-lang/${vanilla.recipe.directory}</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <exclude>io.papermc.paper:*</exclude>
                                    <exclude>net.momirealms:*</exclude>
                                </excludes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>dev.che1s.craftenginerecipe.libs.bstats</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>xyz.xenondevs.invui</pattern>
                                    <shadedPattern>dev.che1s.craftenginerecipe.libs.invui</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>xyz.xenondevs.inventoryaccess</pattern>
                                    <shadedPattern>dev.che1s.craftenginerecipe.libs.inventoryaccess</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.sourceforge.pinyin4j</pattern>
                                    <shadedPattern>dev.che1s.craftenginerecipe.libs.pinyin4j</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <paperweight-mappings-namespace>mojang</paperweight-mappings-namespace>
                                        <CraftEngineRecipe-Minecraft>${mc.label}</CraftEngineRecipe-Minecraft>
                                        <CraftEngineRecipe-InvUI>${invui.version}</CraftEngineRecipe-InvUI>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
